{
  "version": 1,
  "author": "AITM CSE Team",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot_ph", "top": -120, "left": -180, "attrs": { "label": "pH Sensor" } },
    { "type": "wokwi-potentiometer", "id": "pot_turb", "top": -20, "left": -180, "attrs": { "label": "Turbidity" } },
    { "type": "wokwi-potentiometer", "id": "pot_tds", "top": 80, "left": -180, "attrs": { "label": "TDS Sensor" } },
    { "type": "wokwi-potentiometer", "id": "pot_do", "top": 180, "left": -180, "attrs": { "label": "DO Sensor" } },
    { "type": "wokwi-led", "id": "led_safe", "top": -80, "left": 200, "attrs": { "color": "green", "label": "Safe" } },
    { "type": "wokwi-led", "id": "led_alert", "top": -20, "left": 200, "attrs": { "color": "red", "label": "Alert" } },
    { "type": "wokwi-buzzer", "id": "buzzer", "top": 60, "left": 200, "attrs": { "label": "Alarm Buzzer" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:34", "pot_ph:SIG", "green", [ "h0" ] ],
    [ "esp:35", "pot_turb:SIG", "blue", [ "h0" ] ],
    [ "esp:32", "pot_tds:SIG", "yellow", [ "h0" ] ],
    [ "esp:33", "pot_do:SIG", "purple", [ "h0" ] ],
    [ "esp:2", "led_safe:A", "green", [ "h0" ] ],
    [ "esp:18", "led_alert:A", "red", [ "h0" ] ],
    [ "esp:19", "buzzer:2", "orange", [ "h0" ] ],
    [ "esp:GND.1", "led_safe:K", "black", [ "h0" ] ],
    [ "esp:GND.2", "led_alert:K", "black", [ "h0" ] ],
    [ "esp:GND.3", "buzzer:1", "black", [ "h0" ] ]
  ]
}
